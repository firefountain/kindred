{
  "name": "kindred",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "node scripts/dev.js",
    "install:all": "pnpm install",
    "build": "pnpm --filter kindred-web build",
    "start": "pnpm --filter kindred-server start",
    "test": "pnpm --filter @kindred/epub-core test",
    "check": "pnpm test && pnpm build"
  }
}
